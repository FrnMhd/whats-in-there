{
  "manifest_version": 3,
  "name": "WhatsApp Privacy Shield",
  "version": "1.0.0",
  "description": "Smart, resilient privacy protection for WhatsApp Web with customizable blur and instant live reveal.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "constants.js",
        "storage.js",
        "dom-detector.js",
        "privacy-engine.js",
        "observer.js",
        "diagnostics.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-privacy": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Toggle WhatsApp Privacy Protection ON/OFF"
    }
  }
}
